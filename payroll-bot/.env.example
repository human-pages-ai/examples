# Human Pages API
API_URL=https://humanpages.ai
AGENT_API_KEY=hp_your_agent_api_key_here

# Coinbase Developer Platform — agentic wallet (no passwords, no manual signing)
# Get these from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Wallet name — idempotent, same name always resolves to same address
CDP_WALLET_NAME=payroll-bot

# Network for USDC payments
PAYMENT_NETWORK=base
